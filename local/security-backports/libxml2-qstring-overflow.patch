Description: Backport QName pool sizing fix, sharing a checked size_t length
Origin: https://github.com/GNOME/libxml2/commit/a4cba4b5b5a8c42e155ed42d2d2a44955465a2e4
Bug: https://security-tracker.debian.org/tracker/CVE-2026-86138
Forwarded: not-needed

--- a/dict.c
+++ b/dict.c
@@ -310,6 +310,11 @@
     const xmlChar *ret;
     size_t size = 0; /* + sizeof(_xmlDictStrings) == 1024 */
     size_t limit = 0;
+    size_t qnamelen = (size_t) namelen + plen;
+
+    if (qnamelen < namelen || qnamelen == SIZE_MAX)
+        return(NULL);
+    qnamelen++; /* colon; pool comparison also reserves the final NUL */
 
     if (prefix == NULL) return(xmlDictAddString(dict, name, namelen));
 
@@ -318,7 +323,7 @@
 #endif
     pool = dict->strings;
     while (pool != NULL) {
-	if ((size_t)(pool->end - pool->free) > namelen + plen + 1)
+	if ((size_t)(pool->end - pool->free) > qnamelen)
 	    goto found_pool;
 	if (pool->size > size) size = pool->size;
         limit += pool->size;
@@ -332,10 +337,21 @@
             return(NULL);
         }
 
-        if (size == 0) size = 1000;
-	else size *= 4; /* exponential growth */
-        if (size < 4 * (namelen + plen + 1))
-	    size = 4 * (namelen + plen + 1); /* just in case ! */
+        if (size == 0) {
+            size = 1000;
+        } else {
+            if (size < (SIZE_MAX - sizeof(xmlDictStrings)) / 4)
+                size *= 4; /* exponential growth */
+            else
+                size = SIZE_MAX - sizeof(xmlDictStrings);
+        }
+        if (size / 4 < qnamelen) {
+            if (qnamelen <
+                    (SIZE_MAX - sizeof(xmlDictStrings)) / 4)
+                size = 4 * (qnamelen); /* just in case ! */
+            else
+                return(NULL);
+        }
 	pool = (xmlDictStringsPtr) xmlMalloc(sizeof(xmlDictStrings) + size);
 	if (pool == NULL)
 	    return(NULL);
