+void TestKeePass1Reader::testNoDeletedMetastreamReferences()
+{
+    KeePass1Reader reader;
+    auto db = reader.readDatabase(QString(KEEPASSX_TEST_DATA_DIR).append("/basic.kdb"), "masterpw", 0);
+    QVERIFY(db);
+    // The public upstream fixture includes custom-icon metadata. Metastreams
+    // are deleted during import; later streams must not retain their pointers.
+    const auto live = db->rootGroup()->entriesRecursive();
+    QCOMPARE(reader.m_entryUuids.size(), live.size());
+    QCOMPARE(reader.m_entryGroupIds.size(), live.size());
+    for (Entry* entry : reader.m_entryUuids) {
+        QVERIFY(live.contains(entry));
+    }
+    for (Entry* entry : reader.m_entryGroupIds.keys()) {
+        QVERIFY(live.contains(entry));
+    }
+}
+
 void TestKeePass1Reader::testBasic()
 {
     QVERIFY(m_db->deletedObjects().isEmpty());
