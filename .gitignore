# This repository contains maintained inputs, not the surrounding workstation.
/*
!/.gitignore
!/.gitattributes
!/.gitleaks.toml
!/AGENTS.md
!/README.md
!/auto/
!/config/
!/local/
!/tests/
!/scripts/
!/docs/

# Generated live-build trees, packages, local builds and reports outside docs.
**/.build/
**/chroot/
**/binary/
**/cache/
**/node_modules/
**/.venv/
**/__pycache__/
*.py[cod]
*.deb
*.udeb
*.o
*.so
*.a
*.debug
*.log
*.tmp
*.swp
*~
/config/includes.chroot/usr/local/share/portable/native-parole/
/config/includes.chroot/usr/local/share/portable/native-conky/

# Images, archives, backups, firmware-variable files and filesystem mounts.
*.iso
*.img
*.raw
*.qcow*
*.vmdk
*.vdi
*.vhd*
*.squashfs
*.luks
*.fd
*.tar
*.tar.*
*.tgz
*.zip
*.7z
**/backups/
**/snapshots/
**/releases/
**/mounts/
**/mnt/
**/Private/
**/private/
**/AppState/
**/PortableSettings/
**/SystemSettings/
**/.petalos-auth/
**/.portable-keys/

# Credentials, actual VPN profiles, encryption metadata and access identities.
.env
.env.*
credentials.json
credentials-*.json
*credentials*.json
!audit-credentials-guest-result.json
*.key
*.pem
*.p12
*.pfx
*.gpg
*.age
*.kdb
*.kdbx
*.keyx
*.hash
shadow
gshadow
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
ssh_host_*
authorized_keys*
known_hosts*
*.ppk
*.ovpn
wg*.conf
*-adb.conf
**/wireguard/*.conf
**/Network/Profiles/
*luks*header*
*LUKS*header*
*.hdr
*.header

# PETALOS-HANDOFF.md is an intentionally untracked local conversation record.
# Public verification keys and authored fixture scripts are maintained inputs;
# private/access keys and generated fixture credentials are not.
