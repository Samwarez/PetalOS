#!/usr/bin/python3 -I
"""Native-only idle locking and XFCE lock-action integration."""
import fcntl
import os
import stat
import subprocess
import sys

if os.getuid() != 1000 or os.environ.get('XDG_SESSION_TYPE') != 'wayland':
    raise SystemExit(0)
sys.path.insert(0, '/usr/local/lib/portable')
from desktop_session import environment
try:
    desktop = environment()
    fd = os.open('/run/user/1000/portable-wayland-idle', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    info = os.fstat(fd)
    assert info.st_uid == 1000 and stat.S_ISREG(info.st_mode) and not info.st_mode & 0o077
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit(0)
except Exception:
    raise SystemExit(1)
os.set_inheritable(fd, True)
query = ['/usr/bin/xfconf-query', '-c', 'xfce4-session', '-p', '/general/LockCommand']
exists = subprocess.run(query, env=desktop, capture_output=True, timeout=5).returncode == 0
command = query + ([] if exists else ['--create', '--type', 'string']) + ['--set', '/usr/local/bin/portable-lock']
subprocess.run(command, env=desktop, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
os.execve('/usr/bin/swayidle', ['swayidle', '-w', 'timeout', '600', '/usr/local/bin/portable-lock --idle',
                              'before-sleep', '/usr/local/bin/portable-lock'], desktop)
