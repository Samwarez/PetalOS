#!/usr/bin/python3 -I
"""aMule preview command; asks the fixed broker to open one local media file."""
import json
import socket
import sys

sys.path.insert(0, '/usr/local/lib/portable')


def main():
    try:
        from compartments import inside
        assert inside('amule') and len(sys.argv) == 2
        data = json.dumps({'path': sys.argv[1]}).encode() + b'\n'
        assert len(data) <= 8192
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(35)
            connection.connect('/run/user/944/portable-media/control.sock')
            connection.sendall(data)
            assert connection.recv(32) == b'OK\n'
        return 0
    except Exception:
        import gi
        gi.require_version('Gtk', '3.0')
        from gi.repository import Gtk
        dialog = Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text='Media could not be opened. The file must be in aMule’s download folder and readable by the desktop user. Retry after any previous player finishes closing.')
        dialog.run(); dialog.destroy()
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
