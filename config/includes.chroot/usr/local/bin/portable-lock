#!/usr/bin/python3 -I
"""Native compositor session lock; SYSTEM authentication never opens Private."""
import os
import fcntl
import stat
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, '/usr/local/lib/portable')
from desktop_session import environment

try:
    assert os.getuid() == 1000
    assert sys.argv[1:] in ([], ['--idle'])
    desktop = environment()
    fd = os.open('/run/user/1000/portable-session-lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    info = os.fstat(fd)
    assert info.st_uid == 1000 and stat.S_ISREG(info.st_mode) and not info.st_mode & 0o077
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit(0)
    os.set_inheritable(fd, True)
    action = 'idle-lock' if sys.argv[1:] else 'lock'
    secured = subprocess.run(['/usr/bin/sudo', '-n', '--', '/usr/local/sbin/portable-storage', action],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, timeout=20)
    if secured.returncode == 76:
        raise SystemExit(0)
    if secured.returncode:
        raise RuntimeError('Encrypted storage was not secured.')
    desktop.update({'HOME': '/home/Petal', 'USER': 'Petal', 'LOGNAME': 'Petal',
                    'PATH': '/usr/local/bin:/usr/bin:/bin', 'GDK_BACKEND': 'wayland'})
    # XFCE powers the display off AFTER its LockCommand returns. Return only
    # when the compositor confirms the lock, never wait here for user unlock.
    # gtklock's daemon parent exits successfully on its locked-event handshake;
    # the locker daemon retains this same flock descriptor across its fork.
    result = subprocess.run(['/usr/bin/gtklock', '--daemonize',
                            '--config', '/usr/local/share/portable/gtklock.ini',
                            '--unlock-command', '/usr/local/libexec/portable-display-wake'],
                            env=desktop, pass_fds=(fd,), timeout=15)
    if result.returncode:
        raise RuntimeError('The compositor did not confirm the session lock.')
except Exception:
    subprocess.run(['/usr/local/bin/portable-message', '--notify', 'error',
                    'The session could not be locked or its display restored.'], timeout=10)
    raise SystemExit(1)
