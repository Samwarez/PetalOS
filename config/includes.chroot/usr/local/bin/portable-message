#!/usr/bin/python3
import datetime
import fcntl
import os
from pathlib import Path
import subprocess
import sys
import tempfile

args = sys.argv[1:]
notify = bool(args and args[0] == "--notify")
if notify:
    args.pop(0)

if len(args) < 2 or args[0] not in ("info", "success", "warning", "error"):
    raise SystemExit(
        "Usage: portable-message [--notify] info|success|warning|error MESSAGE"
    )

level = args.pop(0)
message = " ".join(" ".join(args).split())[:400]

runtime = Path(f"/run/user/{os.getuid()}")
if not runtime.is_dir() or runtime.stat().st_uid != os.getuid():
    raise SystemExit("User runtime directory is unavailable.")

# Refuse to put the activity log on persistent storage.
check = subprocess.run(
    ["/usr/bin/findmnt", "-n", "-o", "FSTYPE", "--target", str(runtime)],
    capture_output=True, text=True, check=True
)
if check.stdout.strip() != "tmpfs":
    raise SystemExit("Activity logging requires a RAM-based runtime directory.")

directory = runtime / "portable-status"
directory.mkdir(mode=0o700, exist_ok=True)
os.chmod(directory, 0o700)
log = directory / "activity.log"

timestamp = datetime.datetime.now(datetime.timezone.utc).strftime("%H:%M:%S")
entry = f"{timestamp} UTC [{level.upper()}] {message}\n"

with open(directory / "activity.lock", "a") as lock:
    os.chmod(lock.name, 0o600)
    fcntl.flock(lock, fcntl.LOCK_EX)

    lines = log.read_text().splitlines(keepends=True) if log.exists() else []
    lines.append(entry)

    fd, temporary = tempfile.mkstemp(prefix=".activity-", dir=directory)
    try:
        with os.fdopen(fd, "w") as output:
            output.writelines(lines[-80:])
        os.replace(temporary, log)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

if notify:
    icon = {
        "info": "dialog-information",
        "success": "emblem-default",
        "warning": "dialog-warning",
        "error": "dialog-error",
    }[level]
    try:
        subprocess.run(
            ["/usr/bin/notify-send", "--app-name=Portable",
             "--expire-time=6000", f"--icon={icon}",
             "--", "Portable", message],
            timeout=3, check=False,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
    except (OSError, subprocess.TimeoutExpired):
        pass
