#!/bin/bash
set -euo pipefail
umask 007
if ! /usr/bin/python3 -I -c 'import sys;sys.path.insert(0,"/usr/local/lib/portable");from compartments import inside;sys.exit(0 if inside("amule") else 1)'; then
    if [[ ${1:-} == --prepare ]]; then
        exec /usr/bin/sudo -n -- /usr/local/sbin/portable-compartment prepare amule
    fi
    exec /usr/bin/sudo -n -- /usr/local/sbin/portable-compartment launch amule "$@"
fi

fail() {
    echo "$1" >&2
    read -r -p "Press Enter to close." || true
    exit 1
}

state=$(/usr/local/bin/portable-download-prepare amule) ||
    fail "aMule was not started."

downloads="$PORTABLE_STATE_ROOT/Downloads/amule"
mkdir -p "$downloads/complete"

exec 9>"$state/launcher.lock"
flock -n 9 || fail "aMule is already running."

python3 - "$state" "$downloads" <<'PY'
import configparser
import sys
from pathlib import Path

state, downloads = map(Path, sys.argv[1:])
filename = state / "amule.conf"

config = configparser.ConfigParser(interpolation=None, strict=False)
config.optionxform = str
if filename.exists():
    config.read(filename)

settings = {
    "eMule": {
        "IncomingDir": str(downloads / "complete"),
        "TempDir": str(downloads / "incomplete"),
        "NewVersionCheck": "0",
        "UPnPEnabled": "0",
        "IPFilterAutoLoad": "0",
        "AddServerListFromServer": "0",
        "AddServerListFromClient": "0",
        "OnlineSignature": "0",
        "VerboseDebugLogfile": "0",
        "VideoPlayer": "/usr/local/bin/portable-amule-player",
    },
    "ExternalConnect": {
        "AcceptExternalConnections": "0",
        "UPnPECEnabled": "0",
    },
    "WebServer": {
        "Enabled": "0",
        "UPnPWebServerEnabled": "0",
    },
}

for section, values in settings.items():
    if not config.has_section(section):
        config.add_section(section)
    for key, value in values.items():
        config.set(section, key, value)

with filename.open("w") as output:
    config.write(output, space_around_delimiters=False)
PY

[[ ${1:-} != --prepare ]] || exit 0
exec -a amule /usr/bin/amule.portable-real --config-dir="$state" "$@"
