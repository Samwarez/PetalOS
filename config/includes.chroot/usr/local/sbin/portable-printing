#!/usr/bin/python3 -I
"""Explicit, session-only CUPS control; never alter network policy."""
import os
import subprocess
import sys


def command(*args):
    return subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, timeout=30, check=True)


def stop():
    # --now also closes socket activation. Leave discovery/path units masked.
    command('/usr/bin/systemctl', 'mask', '--now', 'cups.service', 'cups.socket')


def main():
    if os.geteuid() != 0 or sys.argv[1:] not in (['start'], ['stop']):
        return 1
    try:
        if sys.argv[1] == 'stop':
            stop()
        else:
            command('/usr/sbin/cupsd', '-t')
            try:
                command('/usr/bin/systemctl', 'unmask', 'cups.service', 'cups.socket')
                command('/usr/bin/systemctl', 'start', 'cups.service')
                command('/usr/bin/systemctl', 'is-active', '--quiet', 'cups.service')
            except Exception:
                stop()
                raise
        return 0
    except Exception:
        return 1


if __name__ == '__main__':
    sys.exit(main())
