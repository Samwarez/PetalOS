#!/usr/bin/python3 -I
"""Fixed PAM verifier: password arrives only through stdin, never arguments."""
import ctypes
import fcntl
import hmac
import os
from pathlib import Path
import resource
import stat
import sys
import time

resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
ctypes.CDLL('libc.so.6').prctl(4, 0, 0, 0, 0)  # PR_SET_DUMPABLE

def main():
    if (os.geteuid() != 0 or sys.argv[1:] or os.environ.get('SUDO_UID') != '1000'
            or os.environ.get('SUDO_USER') != 'Petal'):
        return 1
    directory = Path('/run/portable-lock-auth')
    if directory.is_symlink():
        return 1
    directory.mkdir(mode=0o700, exist_ok=True)
    info = directory.stat()
    if info.st_uid != 0 or not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o077:
        return 1
    fd = os.open(directory / 'attempt.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'r+b') as lease:
        info = os.fstat(lease.fileno())
        if info.st_uid != 0 or not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077:
            return 1
        try:
            fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 1
        # A single verifier at a time, with a fixed minimum delay. No attempt
        # history, password or credential is written to the RAM lock file.
        time.sleep(3)
        supplied = sys.stdin.buffer.read(513)
        if supplied.endswith(b'\x00'):
            supplied = supplied[:-1]
        if not supplied or len(supplied) > 512 or any(v in supplied for v in (b'\x00', b'\n', b'\r')):
            return 1
        sys.path.insert(0, '/usr/local/lib/portable')
        from private_storage import authenticate_system
        return 0 if authenticate_system(supplied) else 1

try:
    raise SystemExit(main())
except Exception:
    # PAM receives only failure; never emit password/hash/error details.
    raise SystemExit(1)
