#!/usr/bin/python3 -I
"""Fixed read-only launch gate. No arguments, state changes or cached grants."""
import fcntl
import os
import stat
import subprocess
import sys
import time


def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        return 1
    # Read the same lock used by VPN transactions, without creating/replacing it.
    descriptor = os.open('/run/portable-vpn.lock', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, 'rb') as lock:
        info = os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077 or info.st_nlink != 1:
            return 1
        deadline = time.monotonic() + 2
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    return 1
                time.sleep(0.05)
        environment = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C', 'HOME': '/root'}
        for command, timeout in [
            (['/usr/local/sbin/portable-check-vpn'], 20),
            (['/usr/bin/chronyc', 'waitsync', '1', '0.5', '0', '1'], 3),
        ]:
            result = subprocess.run(command, stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                env=environment, cwd='/', timeout=timeout)
            if result.returncode:
                return 1
    return 0


if __name__ == '__main__':
    try:
        result = main()
    except Exception:
        result = 1
    if result:
        print('Tor readiness check failed. Check the VPN and synchronized clock.', file=sys.stderr)
    sys.exit(result)
