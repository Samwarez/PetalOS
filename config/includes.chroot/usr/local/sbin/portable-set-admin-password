#!/usr/bin/python3
"""Graphically provision a credential directly in encrypted SYSTEM."""
import os
import pwd
import subprocess
import sys
sys.path.insert(0,'/usr/local/lib/portable')
from account_auth import encode_secret, store_hash, apply_admin_hash, require_sudo_auth
from desktop_session import environment as desktop_environment

try:
    if os.geteuid()!=0:raise RuntimeError()
    account=pwd.getpwuid(1000)
    if account.pw_name not in ('user','Petal'):raise RuntimeError()
    environment=desktop_environment()
    result=subprocess.run(['/usr/sbin/runuser','-u',account.pw_name,'--',
        '/usr/local/bin/portable-dialog','--new-admin-password'],env=environment,capture_output=True)
    if result.returncode:
        print('Administrator setup cancelled; no credential changed.')
        sys.exit(1)
    if len(result.stdout.decode('utf-8')) < 12 or result.stdout == b'prettyplease':
        raise RuntimeError()
    hashed=encode_secret(result.stdout)
    store_hash(hashed)
    apply_admin_hash(hashed)
    require_sudo_auth()
    print('Private administrator credential provisioned in encrypted SYSTEM; Petal password login is disabled.')
except Exception:
    print('Account credential setup failed. No credential contents were logged.',file=sys.stderr)
    sys.exit(1)
