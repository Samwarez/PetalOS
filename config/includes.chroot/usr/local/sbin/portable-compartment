#!/usr/bin/python3 -I
"""Fixed root broker; no caller-supplied executable, environment or root path."""
import fcntl
import os
from pathlib import Path
import re
import signal
import sys
from urllib.parse import urlsplit
sys.path.insert(0, '/usr/local/lib/portable')
from compartments import BASE, ROLES, OFFLINE, CompartmentError, action_lock, gate, prepare, protected, read_record, roles, root_admin_configured, start, stop, supervise, worker_alive


def start_family(backend, frontend, arguments=()):
    """Undo this request's new workers if its second startup stage fails."""
    previous = {app: worker_alive(read_record(app)) for app in (backend, frontend)}
    try:
        start(backend)
        start(frontend, arguments)
    except BaseException:
        # The family action lock excludes another launch. Existing ready
        # sessions belong to earlier requests and must remain available.
        incomplete = False
        for app in (frontend, backend):
            if not previous[app]:
                try:
                    stop(app)
                except CompartmentError:
                    incomplete = True
        if incomplete:
            raise CompartmentError('Application startup failed and cleanup is still pending. Close the application before retrying.')
        raise


def main():
    if os.geteuid() != 0:
        return 1
    arguments = sys.argv[1:]
    if len(arguments) == 3 and arguments[0] == '--worker':
        if os.environ.get('SUDO_USER') or arguments[1] not in ROLES or not re.fullmatch('[a-f0-9]{32}', arguments[2]):
            return 1
        supervise(arguments[1], arguments[2])
        return 0
    if len(arguments) < 2 or arguments[0] not in ('launch', 'prepare', 'stop'):
        return 1
    if os.environ.get('SUDO_USER') != 'Petal' or os.environ.get('SUDO_UID') != '1000':
        return 1
    action, app, *extra = arguments
    if app not in ('tor', 'transmission', 'pan', 'amule', 'sabnzbd') and app not in OFFLINE:
        return 1
    if len(extra) > 32 or any(len(x) > 8192 or any(c in x for c in ('\n', '\r', '\x00')) for x in extra):
        return 1
    if action != 'launch' and extra:
        return 1
    if app == 'tor':
        for value in extra:
            parsed = urlsplit(value)
            if parsed.scheme not in ('http', 'https') or not parsed.hostname or parsed.username or parsed.password:
                return 1
    elif extra and app not in OFFLINE:
        if app == 'sabnzbd' or any(not (x.startswith('/') or x.startswith('file://')
               or (app == 'transmission' and x.startswith('magnet:'))
               or (app == 'amule' and x.startswith('ed2k://'))) for x in extra):
            return 1
    if not root_admin_configured():
        raise CompartmentError('Set the private administrator credential first.')
    def cancelled(*_):
        # The worker has its own cleanup handler. Raising here makes start()
        # terminate and reap its child instead of orphaning a slow launch.
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        raise CompartmentError('Application startup was cancelled.')
    signal.signal(signal.SIGTERM, cancelled)
    signal.signal(signal.SIGINT, cancelled)
    roles(); protected(BASE)
    with action_lock(app):
        if action == 'stop':
            if app == 'tor':
                stop('browser');stop('tor')
            elif app == 'sabnzbd':
                stop('sab-viewer');stop('sabnzbd')
            else:
                stop(app)
            return 0
        gate('browser' if app == 'tor' else app)
        if app == 'tor':
            if action == 'launch':
                start_family('tor', 'browser', extra)
            else:
                start('tor')
        elif app == 'sabnzbd':
            if action == 'launch':
                start_family('sabnzbd', 'sab-viewer')
            else:
                start('sabnzbd')
        elif action == 'launch':
            start(app, extra)
        else:
            prepare(app)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except CompartmentError as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
    except Exception:
        print('The compartment could not start. Check Private, current VPN/clock, administrator setup and application confinement.', file=sys.stderr)
        raise SystemExit(1)
