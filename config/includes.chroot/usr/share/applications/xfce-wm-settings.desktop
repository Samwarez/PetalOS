[Desktop Entry]
Type=Application
Name=Window Appearance
Comment=Set native Wayland window colors and title bars
Exec=/usr/local/bin/portable-window-appearance
Icon=preferences-system-windows
Categories=Settings;DesktopSettings;X-XFCE-SettingsDialog;X-XFCE-PersonalSettings;
OnlyShowIn=XFCE;
Terminal=false
X-XfcePluggable=false
