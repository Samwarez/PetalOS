# Use curated file-manager bookmarks for Private, SYSTEM settings and RAM.
# Raw boot/encryption/internal block volumes are not desktop destinations.
SUBSYSTEM!="block", GOTO="portable_storage_end"
ENV{UDISKS_IGNORE}="1"
ENV{UDISKS_AUTO}="0"
# Ordinary USB filesystems are user-selected content destinations. Do not
# expose encryption containers, internal disks or the PetalOS boot partition.
# Match the physical USB ancestry too. Some storage bridges do not publish
# ID_BUS=usb on the filesystem partition even though the drive uses USB.
SUBSYSTEMS=="usb", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_LABEL}!="PORT_BOOT", ENV{UDISKS_IGNORE}="0"
ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_LABEL}!="PORT_BOOT", ENV{UDISKS_IGNORE}="0"
LABEL="portable_storage_end"
