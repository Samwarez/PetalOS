#include <tunables/global>

profile petalos_transmission /usr/bin/transmission-gtk.portable-real {
  #include <abstractions/petalos-compartment-common>
  network inet,
  network inet6,
  /home/petal-transmission/{,**} rwkl,
  /mnt/ram/{,AppState/,Downloads/} r,
  /mnt/ram/AppState/transmission/{,**} rwkl,
  /mnt/ram/Downloads/transmission/{,**} rwkl,
  /mnt/private/AppState/transmission/{,**} rwkl,
  /mnt/private/Downloads/transmission/{,**} rwkl,
  /mnt/private/{,AppState/,Downloads/} r,
}
