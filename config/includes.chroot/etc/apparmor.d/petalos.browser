# Adapted from Debian trixie torbrowser-launcher Tor Browser policy.
# Copyright Radostan Riedel. BSD-3-clause; full notice:
# /usr/share/doc/petalos/torbrowser-policy-copyright
# Changes: portable RAM paths, sandbox user namespaces and downloads.
#include <tunables/global>
@{torbrowser_installation_dir}=/home/petal-browser/.local/share/portable-tor/tor-browser
@{torbrowser_home_dir}=@{torbrowser_installation_dir}/Browser

@{petalos_browser_executable} = /home/petal-browser/.local/share/portable-tor/tor-browser/Browser/firefox.real

profile petalos_browser @{petalos_browser_executable} {
  #include <abstractions/audio>
  #include <abstractions/petalos-no-persistent-trash>
  #include <abstractions/dri-enumerate>
  #include <abstractions/gnome>
  #include <abstractions/ibus>
  #include <abstractions/mesa>
  #include <abstractions/opencl>
  #include if exists <abstractions/vulkan>
  #include if exists <abstractions/dbus-session>
  #include <abstractions/wayland>

  deny capability sys_ptrace,

  # Uncomment the following lines if you want to give the Tor Browser read-write
  # access to most of your personal files.
  # #include <abstractions/user-download>
  # @{HOME}/ r,

  # Audio support
  /{,usr/}bin/pulseaudio Pixr,

  #dbus,
  network netlink raw,
  deny network inet,
  deny network inet6,
  network unix,

  # ibus socket
  owner @{HOME}/.cache/ibus/dbus-* rw,

  ptrace (trace) peer=@{profile_name},
  signal (receive, send) set=("term") peer=@{profile_name},
  signal (receive) peer=unconfined,

  deny /etc/host.conf r,
  deny /etc/hosts r,
  deny /etc/nsswitch.conf r,
  deny /etc/os-release r,
  deny /etc/resolv.conf r,
  deny /etc/passwd r,
  deny /etc/group r,
  deny /etc/mailcap r,

  /etc/machine-id r,
  /var/lib/dbus/machine-id r,

  /dev/ r,
  /dev/shm/ r,

  owner @{PROC}/@{pid}/cgroup r,
  owner @{PROC}/@{pid}/environ r,
  owner @{PROC}/@{pid}/fd/ r,
  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/oom_score_adj rw,
  owner @{PROC}/@{pid}/smaps r,
  owner @{PROC}/@{pid}/stat r,
  owner @{PROC}/@{pid}/statm r,
  owner @{PROC}/@{pid}/status r,
  owner @{PROC}/@{pid}/task/ r,
  owner @{PROC}/@{pid}/task/*/comm r,
  owner @{PROC}/@{pid}/task/*/stat r,
  @{PROC}/sys/kernel/random/uuid r,

  @{torbrowser_installation_dir}/ r,
  @{torbrowser_installation_dir}/* r,
  @{torbrowser_installation_dir}/.** rwk,
  @{torbrowser_installation_dir}/update.test/ rwk,
  @{torbrowser_home_dir}/.** rwk,
  @{torbrowser_home_dir}/ rw,
  @{torbrowser_home_dir}/** rwk,
  @{torbrowser_home_dir}.bak/ rwk,
  @{torbrowser_home_dir}.bak/** rwk,
  @{torbrowser_home_dir}/*.so mr,
  @{torbrowser_home_dir}/.cache/fontconfig/ rwk,
  @{torbrowser_home_dir}/.cache/fontconfig/** rwkl,
  @{torbrowser_home_dir}/browser/** r,
  @{torbrowser_home_dir}/{,browser/}components/*.so mr,
  @{torbrowser_home_dir}/Downloads/ rwk,
  @{torbrowser_home_dir}/Downloads/** rwk,
  @{torbrowser_home_dir}/firefox rix,
  @{torbrowser_home_dir}/glxtest ix,
  @{torbrowser_home_dir}/{,TorBrowser/UpdateInfo/}updates/[0-9]*/* rw,
  # No updater execution: updates use the external signed-archive installer.
  @{torbrowser_home_dir}/TorBrowser/Data/Browser/.parentwritetest rw,
  @{torbrowser_home_dir}/TorBrowser/Data/Browser/profiles.ini r,
  @{torbrowser_home_dir}/TorBrowser/Data/Browser/profile.default/{,**} rwkl,
  @{torbrowser_home_dir}/TorBrowser/Data/fontconfig/fonts.conf r,
  @{torbrowser_home_dir}/fonts/* l,
  deny @{torbrowser_home_dir}/TorBrowser/Tor/tor x,
  @{torbrowser_home_dir}/TorBrowser/Tor/ r,
  @{torbrowser_home_dir}/TorBrowser/Tor/*.so mr,
  @{torbrowser_home_dir}/TorBrowser/Tor/*.so.* mr,
  @{torbrowser_home_dir}/TorBrowser/Tor/libstdc++/*.so mr,
  @{torbrowser_home_dir}/TorBrowser/Tor/libstdc++/*.so.* mr,

  # parent Firefox process when restarting after upgrade, Web Content processes
  @{petalos_browser_executable} pxmr -> petalos_browser,

  /etc/mailcap r,
  /etc/mime.types r,

  /usr/share/ r,
  /usr/share/glib-2.0/schemas/gschemas.compiled r,
  /usr/share/mime/ r,
  /usr/share/themes/ r,
  /usr/share/applications/** rk,
  /usr/share/gnome/applications/ r,
  /usr/share/gnome/applications/kde4/ r,
  /usr/share/poppler/cMap/ r,
  /etc/xdg/mimeapps.list r,

  # Explicit encrypted download directory, without access to VPN/app state.
  /mnt/ram/{,Downloads/} r,
  /mnt/ram/Downloads/TorBrowser/{,**} rwk,
  /mnt/private/ r,
  /mnt/private/Downloads/ r,
  /mnt/private/Downloads/TorBrowser/{,**} rwk,

  # Distribution homepage
  /usr/share/homepage/ r,
  /usr/share/homepage/** r,

  /sys/bus/pci/devices/ r,
  @{sys}/devices/pci[0-9]*/**/irq r,
  /sys/devices/system/cpu/ r,
  /sys/devices/system/cpu/present r,
  /sys/devices/system/node/ r,
  /sys/devices/system/node/node[0-9]*/meminfo r,
  /sys/fs/cgroup/cpu,cpuacct/{,user.slice/}cpu.cfs_quota_us r,
  deny /sys/class/input/ r,
  deny /sys/devices/virtual/block/*/uevent r,

  # Should use abstractions/gstreamer instead once merged upstream
  /etc/udev/udev.conf r,
  /run/udev/data/+pci:* r,
  /sys/devices/pci[0-9]*/**/uevent r,
  owner /{dev,run}/shm/shmfd-* rw,

  # Required for multiprocess Firefox (aka Electrolysis, i.e. e10s)
  owner /{dev,run}/shm/org.chromium.* rw,
  owner /dev/shm/org.mozilla.ipc.[0-9]*.[0-9]* rw, # for Chromium IPC

  # Required for Wayland display protocol support
  owner /dev/shm/wayland.mozilla.ipc.[0-9]* rw,

  # Silence denial logs about permissions we don't need
  deny @{HOME}/.cache/fontconfig/ rw,
  deny @{HOME}/.cache/fontconfig/** rw,
  deny @{HOME}/.config/gtk-2.0/ rw,
  deny @{HOME}/.config/gtk-2.0/** rw,
  deny @{PROC}/@{pid}/net/route r,
  deny /sys/devices/system/cpu/cpufreq/policy[0-9]*/cpuinfo_max_freq r,
  deny /sys/devices/system/cpu/*/cache/index[0-9]*/size r,
  deny /run/user/[0-9]*/dconf/user rw,
  deny /usr/bin/lsb_release x,

  # Silence denial logs about PulseAudio
  deny /etc/pulse/client.conf r,
  deny /usr/bin/pulseaudio x,
  /run/user/941/pulse/{,**} rwkl,
  # Tor Browser's native Wayland proxy lives inside its private runtime.
  owner /run/user/941/wayland-proxy-[0-9]* rwkl,

  # KDE 4
  owner @{HOME}/.kde/share/config/* r,

  # Xfce4
  /etc/xfce4/defaults.list r,
  /usr/share/xfce4/applications/ r,

  # u2f (tested with Yubikey 4)
  /sys/class/ r,
  /sys/bus/ r,
  /sys/class/hidraw/ r,
  /run/udev/data/c24{5,7,9}:* r,
  /dev/hidraw* rw,
  # Yubikey NEO also needs this:
  /sys/devices/**/hidraw/hidraw*/uevent r,

  # Needed for Firefox sandboxing via unprivileged user namespaces
  userns,
  capability sys_admin,
  capability sys_chroot,
  owner @{PROC}/@{pid}/{gid,uid}_map w,
  owner @{PROC}/@{pid}/setgroups w,

  # Remove these rules once we can assume abstractions/vulkan is recent enough
  # to include them
  /etc/glvnd/egl_vendor.d/{*,.json} r,
  /usr/share/glvnd/egl_vendor.d/{,*.json} r,

  /run/portable-tor/ r,
  /run/portable-tor/{socks.sock,control.sock} rw,
  /run/portable-tor/control_auth_cookie r,
  deny /home/Petal/{,**} rwklx,
}

