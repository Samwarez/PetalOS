#include <tunables/global>

profile petalos_offline_libreoffice flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/petalos-offline-common>
  # Only this role's delegated content; desktop-owned files must be editable.
  /mnt/ram/Documents/libreoffice/{,**} rwkl,
  /mnt/private/Documents/libreoffice/{,**} rwkl,
  deny network inet,
}
