#include <tunables/global>

profile petalos_offline_vim flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/petalos-offline-common>
  # Only this role's delegated content; desktop-owned files must be editable.
  /mnt/ram/Documents/vim/{,**} rwkl,
  /mnt/private/Documents/vim/{,**} rwkl,
  /dev/ptmx rw,
  /dev/pts/{,**} rw,
  /dev/tty rw,
  deny network inet,
}
