  # The root broker supplies a separate real UID, mount/PID/IPC namespace,
  # RAM home, private display and no host buses before entering this policy.
  #include <abstractions/base>
  /usr/** mrix,
  /{,usr/}lib/** mr,
  /lib64/** mr,
  /etc/{,**} r,
  /sys/{,**} r,
  /var/cache/fontconfig/{,**} mr,
  /dev/null rw,
  /dev/zero rw,
  /dev/random r,
  /dev/urandom r,
  /dev/shm/{,**} rwkl,
  /tmp/{,**} rwkl,
  /run/petalos-compartment.json r,
  /run/petalos-imports/{,**} r,
  owner /run/user/[0-9]*/{,**} rwkl,
  /proc/{,**} r,
  owner /proc/*/oom_score_adj w,
  network unix,
  network netlink raw,
  dbus bus=session,
  deny dbus bus=system,
  signal (send,receive) peer=@{profile_name},
  signal (receive) peer=unconfined,
  ptrace (read,trace) peer=@{profile_name},
  deny /{,usr/}bin/{sudo,su,pkexec,mount,umount,setpriv,nsenter,unshare} x,
  deny /usr/local/sbin/{,**} x,
  deny /usr/lib/polkit-1/{,**} x,
  deny /usr/libexec/polkit-agent-helper-1 x,
  deny /etc/{shadow,gshadow} r,
  deny /etc/wireguard/{,**} rwkl,
  deny /home/Petal/{,**} rwklx,
  deny /root/{,**} rwklx,
  deny /.portable-keys/{,**} rwkl,
  deny /mnt/private/Network/{,**} rwkl,
