#include <tunables/global>

profile petalos_offline_html flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/petalos-offline-common>
  # Only this role's delegated content; desktop-owned files must be editable.
  /mnt/ram/Documents/html/{,**} rwkl,
  /mnt/private/Documents/html/{,**} rwkl,
  deny network inet,
}
