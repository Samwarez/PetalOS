[Unit]
Description=PetalOS read-only desktop telemetry
After=nftables.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/portable-telemetry
RuntimeDirectory=portable-telemetry
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadWritePaths=/run/portable-telemetry
InaccessiblePaths=-/mnt/private -/etc/wireguard -/.portable-keys
